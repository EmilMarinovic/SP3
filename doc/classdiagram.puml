@startuml
abstract Medie {
String title
double rating
ArrayList<Category> categories
void searchMedie()
void searchMedieInCategory()
}
class Movie {
int durationInMinutes
}
class Series {
ArrayList<Season> seasons
ArrayList<Episode> episodes
}
class Season {
int numberOfEpisodes
}
class Episode {
int durationInMinutes
}
class User {
ArrayList<Medie> watchedMedie
ArrayList<Medie> wishlist
String username
String password
void showWatchedMedie()
void showWishlist()
}
enum Category {
CRIME
FAMILY
WAR
DRAMA
ROMANCE
}
class Main
interface Playable {
void play()
}
class FileIO
class TextUI





Medie <|-- Movie
Medie <|-- Serie

Serie *-- Season
Season *-- Episode

Playable <|.. Movie
Playable <|.. Episode
@enduml