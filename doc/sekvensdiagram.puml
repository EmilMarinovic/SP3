@startuml
title Streaming: opstart, login, søgning, lister og log ud

actor "Bruger" as B
participant "m : Main" as Main
participant "s : StreamingService" as SS
participant "ui : TextUI" as UI
participant "io : FileIO" as IO
participant "u : User" as U
participant ": Movie / Series" as Med

== Opstart ==
Main -> SS : loadDataMovies()
SS -> IO : readData("data/moviesdata.csv")
IO --> SS : lines
loop for hver linje
    SS -> Med : new Movie(titel, år, genrer, rating)
end

Main -> SS : loadDataSeries()
SS -> IO : readData("data/seriesdata.csv")
IO --> SS : lines
loop for hver linje
    SS -> Med : new Series(titel, år, genrer, rating)
    SS -> Med : addSeason(new Season(nr, antal))
end

Main -> SS : loadDataUser()
SS -> IO : readData("data/userdata.csv")
IO --> SS : lines
loop for hver linje
    SS -> SS : findMedieTitle(titel)
    SS -> U : new User(navn, kode, watched, wishlist)
end

Main -> SS : showStartMenu()

== Startmenu ==
SS -> UI : promptNumeric("Choose:")
UI -> B : 1. Create user / 2. Log in / 0. Close
B --> UI : valg
UI --> SS : valg

alt 1 (Create user)
    SS -> UI : promptText("Type username:") / promptText("Type password:")
    UI --> SS : navn, kode
    SS -> U : new User(navn, kode)
else 2 (Log in)
    SS -> SS : logIn()
    SS -> UI : promptText("Type username")
    UI --> SS : brugernavn
    SS -> SS : findUser(brugernavn)
    alt bruger findes ikke
        SS -> UI : displayMessage("User does not exist!")
    else bruger findes
        loop indtil kode er rigtig
            SS -> UI : promptText("Type password")
            UI --> SS : kode
            SS -> U : getPassword()
            U --> SS : kode
        end
        SS -> SS : currentUser = user, showOptionMenu()
    end
end

== Hovedmenu ==
SS -> UI : promptNumeric("Choose:")
UI --> SS : valg

alt 1 (Search)
    SS -> SS : searchMedie() (Movie / Series / begge)
    SS -> SS : searchByCriteria(mediaType)

    alt Title
        SS -> UI : promptText("Type title:")
        UI --> SS : titel
        SS -> SS : findMedieTitle(titel), matchesMediaType()
        SS -> SS : playOrSave(medie)
    else Genre / Rating / Release year
        SS -> UI : promptText(...) / promptNumeric(...)
        UI --> SS : søgeværdi
        loop for hver Medie i medias
            SS -> Med : getGenresFormatted() / getRating() / getYear()
            Med --> SS : værdi
        end
        SS -> SS : showResultsAndPick(results)
        SS -> UI : displayMessage(nummereret liste)
        SS -> UI : promptNumeric("Pick a number (0 = back)")
        UI --> SS : nummer
        SS -> SS : playOrSave(medie)
    end

    SS -> UI : promptNumeric("1. Play / 2. Save")
    UI --> SS : valg
    alt Play
        SS -> UI : displayMessage(titel + " is now playing...")
        SS -> U : addToWatched(medie)
    else Save
        SS -> U : addToWishlist(medie)
    end

else 2 (Show watched list)
    SS -> U : showWatchedMedie()

else 3 (Show wishlist)
    SS -> U : getWishlist()
    U --> SS : wishlist
    SS -> SS : showResultsAndPick(kopi af wishlist, true)
    SS -> UI : displayMessage(nummereret liste)
    SS -> UI : promptNumeric("Pick a number (0 = back)")
    UI --> SS : nummer
    SS -> SS : playOrRemove(medie)
    SS -> UI : promptNumeric("1. Play / 2. Remove")
    UI --> SS : valg
    alt Play
        SS -> UI : displayMessage(titel + " is now playing...")
        SS -> U : addToWatched(medie)
    else Remove
        SS -> UI : displayMessage("... has been removed from your wishlist")
        SS -> U : removeFromWishlist(medie)
    end
end

== Log ud ==
SS -> UI : promptNumeric("Choose:")
UI --> SS : 0 (Log out)
SS -> SS : endSession()
loop for hver User
    SS -> U : getUsername(), getPassword()
    SS -> U : getWatchedMedieFormatted()
    SS -> U : getWishlistFormatted()
end
SS -> IO : saveData(data, "data/userdata.csv", header)
@enduml